# Copy to .env.local for local development (Vite auto-loads it).
# Base URL of the backend API (see ../backend). Must include /api.
VITE_API_URL=http://localhost:4000/api

# Razorpay (Phase 8 — Card/UPI/Netbanking checkout). This is the public
# "key id" half only (safe to expose client-side) — must match
# RAZORPAY_KEY_ID in backend/.env. Never put the key *secret* here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
